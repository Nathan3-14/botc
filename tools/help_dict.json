{
    "$schema": "../cli/command.schema.json",
    "search": {
        "args": {
            "criteria": {
                "type": "multiple:string",
                "required": true
            }
        },
        "description_short": "Searches downloaded scripts for a set of criteria"
    },
    "display": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            },
            "character_types": {
                "type": "multiple:string",
                "required": false
            } 
        },
        "aliases": ["list"],
        "description_short": "Displays a list of characters of the given script that match the character types given (if provided)"
    },
    "format": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Creates a pdf of the given script",
        "aliases": ["pdf"],
        "deprecated": true
    },
    "download": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Downloads a script with the given name"
    },
    "upload": {
        "args": {
            "script_file": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Uploads, checks and formats a script.json file",
        "description": "Uploads, checks (only if -i flag is not present) and formats a script.json file"
    },
    "image": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Converts a script PDF to an PNG"
    },
    "select": {
        "args": {
            "starting_script": {
                "type": "string",
                "required": true
            },
            "count": {
                "type": "integer",
                "required": false
            }
        },
        "description_short": "Finds non-clashing scripts"
    }
}