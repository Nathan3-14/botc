{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/nathan3-14/botc/cli/help.schema.json",
    "title": "Command",
    "description": "A command",
    "type": "object",
    "properties": {"$schema": {"type": "string"}},
    "patternProperties": {
        "^[a-zA-Z_]+$": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "object",
                    "patternProperties": {
                        "[a-zA-Z_]": {
                            "type": "object",
                            "properties": {
                                "type": {"type": "string"},
                                "required": {"type": "boolean"}
                            },
                            "required": ["type", "required"]
                        }
                    }
                },
                "description": {"type": "string"},
                "description_short": {"type": "string"},
                "aliases": {
                    "type": "array",
                    "items": {"type": "string"}
                },
                "deprecated": {"type": "boolean"}
            },
            "required": ["args", "description_short"]
        }
    },
    "required": ["$schema"],
    "additionalProperties": false
}