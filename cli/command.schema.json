{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/nathan3-14/botc/cli/help.schema.json",
    "title": "Command",
    "description": "A command",
    "type": "object",
    "patternProperties": {
        "[a-zA-Z_]+": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "object",
                    "patternProperties": {
                        "[a-zA-Z_]": {
                            "type": "object",
                            "properties": {
                                "type": {"type": "string"},
                                "required": {"type": "boolean"}
                            }
                        }
                    }
                },
                "description": {"type": "string"},
                "description_short": {"type": "string"},
                "aliases": {
                    "type": "array",
                    "items": {"type": "string"}
                }
            }
        }
    },
    "required": ["args", "description_short"],
    "additionalProperties": false
}