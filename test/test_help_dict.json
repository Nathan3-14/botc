                "required": true
            },
            "number_2": {
                "type": "int",
                "required": true
            }
        },
        "description": "Adds number_1 to number_2 and displays the output",
        "description_short": "Adds two numbers together"
    },
    "subtract": {
        "args": {
            "number_1": {
                "type": "int",
                "required": true
            },
            "number_2": {
                "type": "int",
                "required": true
            }
        },
        "description": "Subtracts number_2 from number_1 and displays the output",
        "description_short": "Subtracts two numbers",
        "aliases": ["sub"]
