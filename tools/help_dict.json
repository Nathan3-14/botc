{
    "$schema": "../cli/command.schema.json",
    "search": {
        "args": {
            "criteria": {
                "type": "multiple:string",
                "required": true
            }
        },
        "description_short": "Searches downloaded scripts for a set of criteria"
    },
    "display": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            },
            "character_types": {
                "type": "multiple:string",
                "required": false
            } 
        },
        "aliases": ["list"],
        "description_short": "Displays a list of characters of the given script that match the character types given (if provided)"
    },
    "format": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Creates a pdf of the given script",
        "aliases": ["pdf"],
        "deprecated": true
    },
    "download": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Downloads a script with the given name",
        "description": "Searches for then downloads a script with the given name, if it already exists, the option to replace it is presented"
    },
    "upload": {
        "args": {
            "script_file": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Uploads a script.json file"
    },
    "image": {
        "args": {
            "script_name": {
                "type": "string",
                "required": true
            }
        },
        "description_short": "Converts a script PDF to an PNG"
    },
    "select": {
        "args": {
            "starting_script": {
                "type": "string",
                "required": true
            },
            "count": {
                "type": "int",
                "required": false
            },
            "overlap_maximum": {
                "type": "int",
                "required": false
            }
        },
        "description_short": "Finds non-clashing scripts",
        "description": "Checks all sets of scripts to find sets of given length with a maximum amount of overlapping characters"
    },
    "sets": {
        "args": {
            "count": {
                "type": "int",
                "required": false
            },
            "overlap_maximum": {
                "type": "int",
                "required": false
            },
            "export": {
                "type": "bool",
                "required": false
            }
        },
        "description_short": "Finds packs of non-clashing scripts",
        "description": "Check all possible sets of scripts to find sets of given length with a maximum amount of overlapping characters",
        "aliases": ["packs"]
    }
}